# Database
# With Supabase this is the Postgres connection string from
# Project Settings → Database. Prisma still owns the schema and every query;
# Supabase supplies auth and file storage on top of the same database.
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio_db?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (required for the admin panel and image uploads)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Bypasses row-level security, so it must never be exposed to the
# browser or committed. Used solely to write to the storage bucket after the
# request has been checked for admin rights.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public bucket holding project screenshots. Defaults to "project-images".
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="project-images"

# Comma-separated emails that get admin access before any role is assigned.
# Once an account exists, prefer setting app_metadata.role = "admin" on it.
ADMIN_EMAILS="you@example.com"

# Email (for contact form - optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="your-email@gmail.com"
