datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// The application's own user record.
///
/// Supabase Auth owns identity — credentials, the OTP, the session. This table
/// owns everything the application needs to say *about* a person: their role,
/// what they have authored, when they last signed in. The two are joined by
/// `supabaseUserId`, the same way a Clerk-backed app keeps a `clerkId`.
///
/// Holding our own row is what lets a post keep its author as a real foreign
/// key, lets roles be granted without touching the auth provider, and means
/// swapping that provider later rewrites one column rather than the schema.
model User {
  id             Int       @id @default(autoincrement())
  /// `auth.users.id` in Supabase. Null for rows that exist only as content
  /// authors and have never signed in — seeded writers, say. Unique, so one
  /// Supabase account can never map to two application users.
  supabaseUserId String?   @unique @db.Uuid
  name           String
  email          String    @unique
  /// Authoritative. Supabase is not consulted for authorisation; this is.
  role           UserRole  @default(USER)
  lastSignInAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  posts Post[]

  @@index([role])
}

model Post {
  id          Int        @id @default(autoincrement())
  title       String
  subtitle    String?
  content     String
  slug        String     @unique
  image       String?
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  author     User       @relation(fields: [authorId], references: [id])
  authorId   Int
  categories Category[]
  tags       Tag[]

  // Indexes for performance
  @@index([status])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([authorId])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Portfolio Models
model Project {
  id               Int           @id @default(autoincrement())
  name             String
  shortDescription String
  /// Cover image: a Supabase bucket URL, or a path under /public for the
  /// screenshots that shipped with the repo.
  image            String
  /// Additional screenshots, in display order.
  images           String[]      @default([])
  /// Platforms this project ships on — drives the public "Web / Android /
  /// Flutter Web / Linux / Windows / macOS" filter. A Flutter build legitimately
  /// carries several, which is why this is a list and not a single column.
  platforms        String[]      @default([])
  github           String?
  link             String
  status           ProjectStatus @default(COMPLETED)
  order            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  technologies Technology[]

  // Indexes for performance
  @@index([status])
  @@index([order])
}

model Technology {
  id        Int          @id @default(autoincrement())
  label     String       @unique
  value     Int          @default(0) // Proficiency level (0-100)
  icon      String? // Icon name or path
  href      String? // Image URL
  category  TechCategory @default(GENERAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  projects Project[]

  // Indexes for performance
  @@index([category])
  @@index([value])
}

model Skill {
  id        Int       @id @default(autoincrement())
  label     String
  type      SkillType
  icon      String? // Icon name
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Indexes for performance
  @@index([type])
  @@index([order])
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  icon        String? // Icon name
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Indexes for performance
  @@index([order])
}

/// A submitted price estimate plus the lead who asked for it.
///
/// The priced figures are stored alongside the selection deliberately: the
/// catalogue will change, and a quote has to stay readable as what was quoted
/// on the day rather than being re-derived later at different prices.
model Estimate {
  id        String @id @default(cuid())
  /// Short human reference quoted back to the visitor, e.g. EST-7Q2KD1X4.
  reference String @unique

  // -- Selection
  industrySlug       String
  industryLabel      String
  industryMultiplier Float
  projectTypeSlug    String
  projectTypeLabel   String
  featureSlugs       String[]
  /// [{ title, description }] — free text, so it stays JSON rather than a table.
  customFeatures     Json
  /// The full server-computed breakdown as rendered to the visitor.
  breakdown          Json

  // -- Priced figures, in whole shillings
  currency       String @default("KES")
  subtotalKes    Int
  rangeLowKes    Int
  rangeHighKes   Int
  estimatedWeeks Float

  // -- Lead
  fullName String
  email    String
  phone    String?
  company  String?
  country  String  @default("KE")
  message  String?

  status    EstimateStatus @default(NEW)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// Enums
enum EstimateStatus {
  NEW
  REVIEWED
  SCHEDULED
  WON
  LOST
  ARCHIVED
}

enum UserRole {
  USER
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}

enum SkillType {
  TECHNICAL
  SOFT
}

enum TechCategory {
  DESIGN
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  GENERAL
}
